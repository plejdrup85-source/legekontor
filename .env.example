# Required for SSO. Use the same shared secret as the dashboard environment.
SSO_SECRET=
SSO_DASHBOARD_URL=

# Defaults shown explicitly for local development.
SSO_EXPECTED_AUD=legekontor
SSO_EXPECTED_ISSUER=onemed-dashboard
DATA_DIR=./var/data

# Optional, but enables Claude-assisted parsing and matching.
ANTHROPIC_API_KEY=
